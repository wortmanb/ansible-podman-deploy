# Generated PKI (contains the CA private key -- back it up somewhere safe)
/pki
/collections
# Offline asset cache (GBs of images/artifacts); built by build-cache.yml
/cache
*.retry
/.ansible/
/.venv
.vault_pass*
# Ansible Vault secrets (encrypted, but kept out of git)
inventory/group_vars/all/vault.yml
# Site-specific hostnames; see inventory/hosts.yml.example
inventory/hosts.yml
# Site-specific settings; see inventory/group_vars/all/overrides.yml.example
inventory/group_vars/all/overrides.yml
# Customer-provided TLS certs and private keys (tls_mode: provided)
/certs/
