#!/bin/sh
# Generated by bootstrap-rhel8.yml. Installs python3.12 and the selinux
# bindings shim (+ its distro dependency) so Ansible modules run on this host.
# Safe to re-run.
set -eu

dnf -y install python3.12 python3.12-pip

if /usr/bin/python3.12 -c 'import selinux' 2>/dev/null; then
  echo "selinux bindings already present"
  exit 0
fi

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
{% for item in bootstrap_wheel_items %}
base64 -d > "$dir/{{ item[1] }}" <<'WHEEL'
{{ item[0] | regex_replace('(.{76})', '\\1\n') }}
WHEEL
{% endfor %}
/usr/bin/python3.12 -m pip install --no-index --no-deps --find-links "$dir" "$dir"/*.whl
/usr/bin/python3.12 -c 'import selinux'
echo "installed selinux bindings"
