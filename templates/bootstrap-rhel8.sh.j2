#!/bin/sh
# Generated by bootstrap-rhel8.yml. Installs python3.12 and the selinux
# bindings shim so Ansible modules run on this host. Safe to re-run.
set -eu

dnf -y install python3.12 python3.12-pip

if /usr/bin/python3.12 -c 'import selinux' 2>/dev/null; then
  echo "selinux bindings already present"
  exit 0
fi

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
base64 -d > "$dir/{{ bootstrap_wheel_name }}" <<'WHEEL'
{{ bootstrap_wheel_b64 }}
WHEEL
/usr/bin/python3.12 -m pip install --no-index --no-deps "$dir/{{ bootstrap_wheel_name }}"
/usr/bin/python3.12 -c 'import selinux'
echo "installed selinux bindings"
