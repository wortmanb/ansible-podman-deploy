# {{ ansible_managed }}
FLEET_SERVER_ENABLE=true
FLEET_SERVER_ELASTICSEARCH_HOST={{ es_urls[0] }}
FLEET_SERVER_ELASTICSEARCH_CA=/certs/ca.crt
FLEET_SERVER_SERVICE_TOKEN={{ fleet_server_token.content | b64decode | trim }}
FLEET_SERVER_POLICY_ID={{ fleet_server_policy_id }}
FLEET_SERVER_CERT=/certs/fleet-server.crt
FLEET_SERVER_CERT_KEY=/certs/fleet-server.key
# Enroll via the public name (it must match the cert, which may be
# customer-provided); the quadlet maps it to this container's loopback.
FLEET_URL={{ fleet_server_url }}
FLEET_CA=/certs/ca.crt
FLEET_SERVER_PORT={{ fleet_server_port }}
