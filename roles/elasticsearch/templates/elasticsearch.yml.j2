# {{ ansible_managed }}
cluster.name: {{ es_cluster_name }}
node.name: {{ es_node.name }}
# node.roles is unset, so every node carries all roles.

network.host: 0.0.0.0
discovery.seed_hosts: {{ es_nodes | map(attribute='name') | list | to_json }}
{% if elasticsearch_forming | bool %}
# Present only while the cluster forms; site.yml removes it, with a rolling
# restart, as soon as all nodes have joined.
cluster.initial_master_nodes: {{ es_nodes | map(attribute='name') | list | to_json }}
{% endif %}

xpack.license.self_generated.type: basic
xpack.security.enabled: true
xpack.security.enrollment.enabled: false

# HTTP: external cert (tls_mode generated or provided).
xpack.security.http.ssl:
  enabled: true
  key: certs/http.key
  certificate: certs/http.crt
  certificate_authorities: [certs/http-ca.crt]

xpack.security.transport.ssl:
  enabled: true
  # Nodes reconnect via container IPs (publish addresses), which aren't in
  # the cert SANs, so hostname verification ("full") breaks cluster
  # formation. The private CA only issues certs to these nodes.
  verification_mode: certificate
  key: certs/node.key
  certificate: certs/node.crt
  certificate_authorities: [certs/ca.crt]
