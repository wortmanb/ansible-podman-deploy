# {{ ansible_managed }}
cluster.name: {{ es_cluster_name }}
node.name: {{ es_node.name }}
# node.roles is unset, so every node carries all roles.

network.host: 0.0.0.0
discovery.seed_hosts: {{ es_nodes | map(attribute='name') | list | to_json }}
{% if elasticsearch_bootstrap | bool %}
# Present only while bootstrapping; removed automatically on the next run.
cluster.initial_master_nodes: {{ es_nodes | map(attribute='name') | list | to_json }}
{% endif %}

xpack.license.self_generated.type: basic
xpack.security.enabled: true
xpack.security.enrollment.enabled: false

xpack.security.http.ssl:
  enabled: true
  key: certs/node.key
  certificate: certs/node.crt
  certificate_authorities: [certs/ca.crt]

xpack.security.transport.ssl:
  enabled: true
  verification_mode: full
  key: certs/node.key
  certificate: certs/node.crt
  certificate_authorities: [certs/ca.crt]
